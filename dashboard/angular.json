{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "dashboard": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "IBMPlexSans-Regular-Latin1.woff2",
                "input": "node_modules/@ibm/plex-sans/fonts/split/woff2",
                "output": "fonts/plex-sans"
              },
              {
                "glob": "IBMPlexSans-Regular-Pi.woff2",
                "input": "node_modules/@ibm/plex-sans/fonts/split/woff2",
                "output": "fonts/plex-sans"
              },
              {
                "glob": "IBMPlexSans-Medium-Latin1.woff2",
                "input": "node_modules/@ibm/plex-sans/fonts/split/woff2",
                "output": "fonts/plex-sans"
              },
              {
                "glob": "IBMPlexSans-Medium-Pi.woff2",
                "input": "node_modules/@ibm/plex-sans/fonts/split/woff2",
                "output": "fonts/plex-sans"
              },
              {
                "glob": "IBMPlexSans-SemiBold-Latin1.woff2",
                "input": "node_modules/@ibm/plex-sans/fonts/split/woff2",
                "output": "fonts/plex-sans"
              },
              {
                "glob": "IBMPlexSans-SemiBold-Pi.woff2",
                "input": "node_modules/@ibm/plex-sans/fonts/split/woff2",
                "output": "fonts/plex-sans"
              },
              {
                "glob": "LICENSE.txt",
                "input": "node_modules/@ibm/plex-sans",
                "output": "fonts/plex-sans"
              },
              {
                "glob": "IBMPlexMono-Regular-Latin1.woff2",
                "input": "node_modules/@ibm/plex-mono/fonts/split/woff2",
                "output": "fonts/plex-mono"
              },
              {
                "glob": "IBMPlexMono-Regular-Pi.woff2",
                "input": "node_modules/@ibm/plex-mono/fonts/split/woff2",
                "output": "fonts/plex-mono"
              },
              {
                "glob": "IBMPlexMono-Medium-Latin1.woff2",
                "input": "node_modules/@ibm/plex-mono/fonts/split/woff2",
                "output": "fonts/plex-mono"
              },
              {
                "glob": "IBMPlexMono-Medium-Pi.woff2",
                "input": "node_modules/@ibm/plex-mono/fonts/split/woff2",
                "output": "fonts/plex-mono"
              },
              {
                "glob": "LICENSE.txt",
                "input": "node_modules/@ibm/plex-mono",
                "output": "fonts/plex-mono"
              }
            ],
            "styles": ["src/styles.css"],
            "loader": {
              ".graphqls": "text"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "dashboard:build:production"
            },
            "development": {
              "buildTarget": "dashboard:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
