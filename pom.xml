<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>io.github.mustafanazeer.spaceflux</groupId>
  <artifactId>spaceflux</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <module>risk-engine</module>
    <module>db-migrate</module>
    <module>query-api</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <orekit.version>13.1.8</orekit.version>
    <jackson-bom.version>3.1.7</jackson-bom.version>
    <kafka.version>4.2.2</kafka.version>
    <json-schema-validator.version>3.0.8</json-schema-validator.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.orekit</groupId>
        <artifactId>orekit</artifactId>
        <version>${orekit.version}</version>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${json-schema-validator.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
